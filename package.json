{
  "name": "xpensiv-mcp",
  "version": "0.1.0",
  "description": "TypeScript client and CLI for the Xpensiv design-check API (REST and MCP).",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" }
  },
  "bin": { "xpensiv-mcp": "bin/xpensiv-mcp.js" },
  "files": ["dist/src", "bin"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kroevasuperadmin/xpensiv-mcp.git" },
  "keywords": ["xpensiv", "mcp", "design-check", "sdk", "cli"],
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "5.9.3"
  }
}
